# Build context trim for the Docker image (docker/jusync-sender/Dockerfile).
# Version stamp is passed explicitly (-DUSD_DEVICE_BUILD_VERSION_EXPLICIT),
# so .git is not needed inside the image.
.git
.gitignore
_build*
build*
**/*.exp
**/*.pdb
**/*.obj
.vs
.idea
docs
*.md
!docker/jusync-sender/*.md
