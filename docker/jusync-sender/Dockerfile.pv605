# pv-anari-usd 6.0.5: current ANARI-USD RawGeo v3 device + ParaView 6.1 desktop.
#
# Build (context = repo root):
#   docker build -f docker/jusync-sender/Dockerfile -t jusync-sender:6.0.5 .
#   docker build -f docker/jusync-sender/Dockerfile.pv `
#                --build-arg BASE=jusync-sender:6.0.5 `
#                -t staticxg7/pv-anari-usd:6.0.5-desktop .
#   docker build -f docker/jusync-sender/Dockerfile.pv605 `
#                -t staticxg7/pv-anari-usd:6.0.5 .
#
# The ParaView 6.1 tree is taken from the working 6.8 image because
# build-out/pv/lib contains Windows junctions, which Docker rejects as build
# context ("invalid file request"). The device and runtime come from the
# freshly built jusync-sender:6.0.5 base.
ARG BASE=staticxg7/pv-anari-usd:6.0.5-desktop
FROM ${BASE}

COPY --from=staticxg7/pv-anari-usd:6.8 /opt/pv61 /opt/pv61

# ld.so has to resolve the usd library's NEEDED libusd_* deps without
# LD_LIBRARY_PATH: X session startup strips LD_* from the desktop.
RUN printf '/opt/usd/lib\n' > /etc/ld.so.conf.d/zz-anari-usd.conf \
 && mkdir -p /usr/local/lib/anari \
 && ln -sf /usr/local/lib/libanari_library_usd.so /usr/local/lib/anari/ \
 && ldconfig

# A committed container can carry stale X locks; keep the image clean.
RUN rm -f /tmp/.X*-lock /tmp/.X11-unix/X*

# Install the current launcher at both paths the paraview wrapper probes, and
# make the legacy /opt/sender/pv default resolve to the baked tree.
COPY docker/jusync-sender/start-paraview-anari.sh /opt/pv61/start-paraview-anari.sh
COPY docker/jusync-sender/start-paraview-anari.sh /opt/sender/start-paraview-anari.sh
RUN chmod +x /opt/pv61/start-paraview-anari.sh /opt/sender/start-paraview-anari.sh \
 && mkdir -p /opt/sender \
 && ln -sfn /opt/pv61 /opt/sender/pv

ENV JUSYNC_RAWGEO_STRIDE= \
    JUSYNC_RAWGEO_SNAPSHOT_DIR=/work/snaps \
    JUSYNC_VNC_RESOLUTION=1600x900

LABEL org.opencontainers.image.title="pv-anari-usd:6.0.5" \
      org.opencontainers.image.description="ParaView 6.1 + current ANARI-USD RawGeo v3 device + VNC/noVNC desktop" \
      org.opencontainers.image.version="6.0.5"

CMD ["sleep", "infinity"]
