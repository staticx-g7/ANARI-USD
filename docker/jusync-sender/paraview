#!/bin/sh
# Default ParaView: the self-built 6.1 tree, NOT Ubuntu's apt paraview 5.11.2
# (purged from the runtime image - it shadowed this one on PATH).
#
# Prefers the host bind-mounted build-out so hot rebuilds are picked up, and
# falls back to the copy baked into the image at /opt/pv61 (see Dockerfile.pv)
# so the container works on a machine with no /opt/sender mount.
if [ -x /opt/sender/pv/bin/paraview ]; then
    PVROOT=/opt/sender/pv
    LAUNCHER=/opt/sender/start-paraview-anari.sh
else
    PVROOT=/opt/pv61
    LAUNCHER=/opt/pv61/start-paraview-anari.sh
fi

# Stage the ANARI 'usd' device library on container-native storage. Reading it
# straight off the Windows 9p bind mount can hand ld.so stale mmap pages after
# a hot replace, which segfaults (elf_dynamic_do_Rela) even though read() shows
# correct bytes. Re-staged on every launch so a stale copy is never used
# silently.
DEV=/usr/local/lib/libanari_library_usd.so
[ -f /opt/sender/libanari_library_usd.so ] && DEV=/opt/sender/libanari_library_usd.so
mkdir -p /tmp/anarilib && cp -a "$DEV" /tmp/anarilib/ 2>/dev/null

# start-paraview-anari.sh prepends /opt/sender/pv/lib; carry the fallback lib
# dir through its ${LD_LIBRARY_PATH} suffix so /opt/pv61/lib resolves too.
export PVDIR="$PVROOT"
export LD_LIBRARY_PATH="$PVROOT/lib:${LD_LIBRARY_PATH:-}"
exec sh "$LAUNCHER" "$@"
