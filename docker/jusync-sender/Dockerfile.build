# Dev helper: jusync-sender:dev + build-essential, so single example files can
# be compiled in-place without paying for the full image rebuild (the COPY .
# layer in the main Dockerfile invalidates the whole device build on any edit).
#
#   docker build -f docker/jusync-sender/Dockerfile.build -t jusync-sender:build .
#   docker run --rm -v "D:/JSC_Github/ANARI-USD:/src" jusync-sender:build \
#     gcc -O2 -I/usr/local/include /src/examples/anariBigCloudUsd.c \
#         -L/usr/local/lib -lanari -lm -o /src/build-out/anariBigCloudUsd
FROM jusync-sender:dev
ENV DEBIAN_FRONTEND=noninteractive
# Same dev-dep set as the main Dockerfile's builder stage (USD's pxrConfig
# needs TBB, device links ZMQ + the ANARI SDK needs GL headers, python3-dev
# for OpenUSD's cmake components).
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build pkg-config \
      libopenmpi-dev \
      libzmq3-dev cppzmq-dev libtbb-dev zlib1g-dev \
      libgl1-mesa-dev libglu1-mesa-dev xorg-dev libglfw3-dev mesa-common-dev \
      python3-dev \
    && rm -rf /var/lib/apt/lists/*
