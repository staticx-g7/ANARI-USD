# Optional layer: bake the locally built ParaView 6.1 tree into a pv-anari-usd
# image so the container also works WITHOUT the build-out bind mount (another
# machine, CI, someone pulling from the registry).
#
# build-out/ is excluded from the repo-root context by .dockerignore, so unlike
# Dockerfile / Dockerfile.pv this one is built with build-out AS the context:
#
#   docker build -f docker/jusync-sender/Dockerfile.pvbake `
#                -t staticxg7/pv-anari-usd:dev build-out
#
# Not redundant with Dockerfile.pv: that one defines the desktop variant; this
# one only adds the ParaView payload. The /usr/local/bin/paraview and pvserver
# wrappers shipped by Dockerfile prefer /opt/sender/pv when the mount exists, so
# baking this in leaves the hot-reload dev loop untouched.
ARG BASE=staticxg7/pv-anari-usd:6.2
FROM ${BASE}

COPY pv /opt/pv61/
COPY start-paraview-anari.sh /opt/pv61/
RUN chmod +x /opt/pv61/start-paraview-anari.sh

# Undo the sender stride baked into older bases: interactive desktops use the
# launcher's PV_STRIDE, and empty here means the device's full-density default.
ENV JUSYNC_RAWGEO_STRIDE=

# Auto-starts the sender, resolving the binary + snapshot dir for the no-mount
# case. Drop this line to keep the desktop-idle behaviour of Dockerfile.pv.
CMD ["/usr/local/bin/jusync-start.sh"]
