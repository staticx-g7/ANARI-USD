# Build the pv-anari-usd interactive-desktop variant from a jusync-sender build
# (reproduces the staticxg7/pv-anari-usd image lineage: VNC desktop up, sender
# started manually via run-sender.sh in the desktop):
#
#   docker build -f docker/jusync-sender/Dockerfile     -t jusync-sender:6.2 .
#   docker build -f docker/jusync-sender/Dockerfile.pv  -t staticxg7/pv-anari-usd:6.2 .
#
ARG BASE=jusync-sender:6.2
FROM ${BASE}

# tigervnc on noble rejects -localhost no combined with its default config here;
# keep the server loopback-bound but allow the docker -p forward to connect.
RUN sed -i -e 's/^localhost=no$/localhost=yes/' \
           -e 's/ -localhost no//' \
           /usr/local/bin/entrypoint.sh

ENV JUSYNC_VNC_RESOLUTION=1600x900

# Keep the container alive with the desktop up; ParaView/sender run on demand.
CMD ["sleep", "infinity"]
